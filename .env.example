# Базовые переменные окружения
BOT_TOKEN=123456:ABC...
OPENAI_API_KEY=sk-...

# Database Configuration
DATABASE_URL=postgresql+asyncpg://memuser:secret@db:5432/memdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Legacy Postgres variables (for docker-compose compatibility)
POSTGRES_DB=memdb
POSTGRES_USER=memuser
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5433

# Redis Configuration (for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECTION_POOL_SIZE=20

# Telegram Bot Configuration
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PATH=/webhook
BOT_USE_WEBHOOK=false
BOT_WEBHOOK_SECRET=

# MinIO S3-совместимое хранилище
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=memory
MINIO_SECURE=false

# LLM Configuration
OPENAI_API_KEY=sk-...
OPENAI_API_DISABLED=false
OPENAI_API_MAX_TOKENS_OUT=4000
OPENAI_API_TEMPERATURE=0.3
OPENAI_API_TIMEOUT=60

# Legacy LLM variables (for backward compatibility)
LLM_DISABLED=0
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_TOKENS_OUT=2048
LLM_TEMPERATURE=0.7

# Processing Configuration
PROCESSING_PROJECT_MAX_CHUNKS=200
PROCESSING_CHUNK_SIZE=1600
PROCESSING_CHUNK_OVERLAP=150

# UI Configuration  
UI_MAX_MESSAGE_LENGTH=4096
UI_MAX_INLINE_BUTTONS=100
UI_DEFAULT_PAGE_SIZE=5

# Security & Performance
SECURITY_MAX_RETRIES=3
SECURITY_RETRY_BASE_DELAY=1.0
SECURITY_RETRY_MAX_DELAY=10.0
SECURITY_CACHE_TTL=3600
SECURITY_ASK_RATE_LIMIT=10
SECURITY_REFINE_RATE_LIMIT=20
SECURITY_DEBOUNCE_TIMEOUT_MS=500

# Monitoring Configuration
MONITORING_LOG_LEVEL=INFO
MONITORING_SENTRY_DSN=
MONITORING_APP_VERSION=1.0.0
MONITORING_ENABLE_METRICS=true
MONITORING_LOG_FORMAT=json

# Feature Flags (для безопасного внедрения оптимизаций)
FEATURE_USE_WEBHOOK=false
FEATURE_USE_CACHE=false
FEATURE_USE_DEBOUNCE=false
FEATURE_USE_CONNECTION_POOLS=false
FEATURE_USE_RATE_LIMITING=false
FEATURE_USE_QUEUE=false

# Environment Type
ENVIRONMENT=development
